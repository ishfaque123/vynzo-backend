generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum PostVisibility {
  public
  private
}

enum ReactionType {
  like
  love
  haha
  wow
  sad
  angry
}

enum CommentAudience {
  everyone
  followers
  only_me
}

enum Gender {
  male
  female
  custom
}

enum NotificationType {
  follow
  post_like
  post_comment
  comment_like
  comment_reply
  post_share
  new_device_login
  account_restricted
  account_banned
}

enum ReportReason {
  spam
  harassment
  hate_speech
  violence
  nudity
  misinformation
  other
}

model User {
  id                     String            @id @default(uuid())
  googleId               String            @unique @map("google_id")
  username               String?           @unique
  displayName            String?           @map("display_name")
  dateOfBirth            DateTime?         @map("date_of_birth")
  bio                    String?           @db.VarChar(300)
  profilePictureUrl      String?           @map("profile_picture_url")
  coverPhotoUrl          String?           @map("cover_photo_url")
  gender                 Gender?
  website                String?
  phone                  String?
  province               String?
  city                   String?
  country                String?
  profileCompleted       Boolean           @default(false) @map("profile_completed")
  accountStatus          AccountStatus     @default(active) @map("account_status")
  role                   String            @default("user")
  commentsDisabled       Boolean           @default(false) @map("comments_disabled")
  messagePermission      String            @default("everyone") @map("message_permission")
  tagPermission          String            @default("everyone") @map("tag_permission")
  showOnlineStatus       Boolean           @default(true) @map("show_online_status")
  walletBalance          Float             @default(0) @map("wallet_balance")
  usernameChangedAt      DateTime?         @map("username_changed_at")
  displayNameChangedAt   DateTime?         @map("display_name_changed_at")
  dobChangedAt           DateTime?         @map("dob_changed_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  lastActiveAt           DateTime?         @map("last_active_at")
  publicKey              String?           @db.Text @map("public_key")
  posts                  Post[]
  likes                  Like[]
  comments               Comment[]
  commentReactions       CommentReaction[]
  following              Follow[]          @relation("Following")
  followers              Follow[]          @relation("Followers")
  tags                   PostTag[]
  commentTags            CommentTag[]
  notificationsReceived  Notification[]    @relation("NotificationsReceived")
  notificationsTriggered Notification[]    @relation("NotificationsTriggered")
  accountSessions        AccountSession[]
  usagePings             UsagePing[]
  conversationParticipants ConversationParticipant[]
  messagesSent           Message[]
  hiddenMessages         HiddenMessage[]
  closeFriendsOf         CloseFriend[] @relation("CloseFriendOwner")
  closeFriendedBy        CloseFriend[] @relation("CloseFriendTarget")
  reportsMade            Report[]          @relation("ReportsMade")
  hiddenPosts            HiddenPost[]
  blocksMade             Block[]           @relation("BlocksMade")
  blocksReceived         Block[]           @relation("BlocksReceived")
  userReportsMade        UserReport[]      @relation("UserReportsMade")
  userReportsReceived    UserReport[]      @relation("UserReportsReceived")

  @@index([username])
  @@index([country])
  @@map("users")
}

model DeviceSession {
  id         String           @id @default(uuid())
  tokenHash  String           @unique @map("token_hash")
  userAgent  String?          @map("user_agent")
  ipAddress  String?          @map("ip_address")
  city       String?
  country    String?
  createdAt  DateTime         @default(now()) @map("created_at")
  lastUsedAt DateTime         @default(now()) @map("last_used_at")
  expiresAt  DateTime         @map("expires_at")
  accounts   AccountSession[]

  @@index([expiresAt])
  @@map("device_sessions")
}

model AccountSession {
  id              String   @id @default(uuid())
  deviceSessionId String   @map("device_session_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  lastUsedAt      DateTime @default(now()) @map("last_used_at")

  deviceSession DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceSessionId, userId])
  @@index([userId])
  @@map("account_sessions")
}

model UsagePing {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  pingedAt DateTime @default(now()) @map("pinged_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pingedAt])
  @@map("usage_pings")
}

model Post {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  content         String          @db.VarChar(2000)
  imageUrl        String?         @map("image_url")
  visibility      PostVisibility  @default(public)
  commentAudience CommentAudience @default(everyone) @map("comment_audience")
  originalPostId  String?         @map("original_post_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        Like[]
  comments     Comment[]
  tags         PostTag[]
  originalPost Post?     @relation("Reposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      Post[]    @relation("Reposts")
  reports      Report[]
  hiddenBy     HiddenPost[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostTag {
  id     String @id @default(uuid())
  postId String @map("post_id")
  userId String @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_tags")
}

model Like {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  postId    String       @map("post_id")
  type      ReactionType @default(like)
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  postId          String   @map("post_id")
  parentCommentId String?  @map("parent_comment_id")
  content         String   @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentComment Comment?          @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("Replies")
  reactions     CommentReaction[]
  tags          CommentTag[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("comments")
}

model CommentReaction {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  commentId String       @map("comment_id")
  type      ReactionType @default(like)
  createdAt DateTime     @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_reactions")
}

model CommentTag {
  id        String @id @default(uuid())
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_tags")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  actorId   String?          @map("actor_id")
  type      NotificationType
  postId    String?          @map("post_id")
  commentId String?          @map("comment_id")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationsTriggered", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model ShareLink {
  id         String   @id @default(uuid())
  code       String   @unique
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("share_links")
}

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false) @map("is_group")
  groupName String?  @map("group_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  userId          String    @map("user_id")
  lastReadAt      DateTime? @map("last_read_at")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  joinedAt        DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String    @db.Text
  mediaUrl       String?   @map("media_url")
  mediaType      String?   @map("media_type")
  voiceDuration  Int?      @map("voice_duration")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  hiddenFor    HiddenMessage[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CloseFriend {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner  User @relation("CloseFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("CloseFriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([friendId])
  @@map("close_friends")
}

model HiddenMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  messageId String   @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
  @@map("hidden_messages")
}

model Report {
  id         String       @id @default(uuid())
  postId     String       @map("post_id")
  reporterId String       @map("reporter_id")
  reason     ReportReason @default(other)
  details    String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at")

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([postId])
  @@map("reports")
}

model HiddenPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("hidden_posts")
}

model Block {
  id             String   @id @default(uuid())
  blockerId      String   @map("blocker_id")
  blockedId      String   @map("blocked_id")
  hiddenFromList Boolean  @default(false) @map("hidden_from_list")
  createdAt      DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model UserReport {
  id         String       @id @default(uuid())
  reporterId String       @map("reporter_id")
  reportedId String       @map("reported_id")
  reason     ReportReason @default(other)
  details    String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("UserReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedId])
  @@index([reportedId])
  @@map("user_reports")
}

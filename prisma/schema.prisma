generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum PostVisibility {
  public
  private
}

enum ReactionType {
  like
  love
  haha
  wow
  sad
  angry
}

enum CommentAudience {
  everyone
  followers
  only_me
}

model User {
  id                   String        @id @default(uuid())
  googleId             String        @unique @map("google_id")
  username             String?       @unique
  displayName          String?       @map("display_name")
  dateOfBirth          DateTime?     @map("date_of_birth")
  bio                  String?       @db.VarChar(300)
  profilePictureUrl    String?       @map("profile_picture_url")
  coverPhotoUrl        String?       @map("cover_photo_url")
  profileCompleted     Boolean       @default(false) @map("profile_completed")
  accountStatus        AccountStatus @default(active) @map("account_status")
  role                 String        @default("user")
  commentsDisabled     Boolean       @default(false) @map("comments_disabled")
  usernameChangedAt    DateTime?     @map("username_changed_at")
  displayNameChangedAt DateTime?     @map("display_name_changed_at")
  dobChangedAt         DateTime?     @map("dob_changed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  lastActiveAt         DateTime?     @map("last_active_at")
  posts                Post[]
  likes                Like[]
  comments             Comment[]
  commentReactions     CommentReaction[]
  following            Follow[]      @relation("Following")
  followers            Follow[]      @relation("Followers")
  tags                 PostTag[]
  commentTags          CommentTag[]

  @@index([username])
  @@map("users")
}

model Post {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  content         String          @db.VarChar(2000)
  imageUrl        String?         @map("image_url")
  visibility      PostVisibility  @default(public)
  commentAudience CommentAudience @default(everyone) @map("comment_audience")
  originalPostId  String?         @map("original_post_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        Like[]
  comments     Comment[]
  tags         PostTag[]
  originalPost Post?     @relation("Reposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      Post[]    @relation("Reposts")

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostTag {
  id     String @id @default(uuid())
  postId String @map("post_id")
  userId String @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_tags")
}

model Like {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  postId    String       @map("post_id")
  type      ReactionType @default(like)
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  postId          String   @map("post_id")
  parentCommentId String?  @map("parent_comment_id")
  content         String   @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentComment Comment?          @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("Replies")
  reactions     CommentReaction[]
  tags          CommentTag[]

  @@index([postId])
  @@index([parentCommentId])
  @@map("comments")
}

model CommentReaction {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  commentId String       @map("comment_id")
  type      ReactionType @default(like)
  createdAt DateTime     @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_reactions")
}

model CommentTag {
  id        String @id @default(uuid())
  commentId String @map("comment_id")
  userId    String @map("user_id")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_tags")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}
